# Vault: tracked, except raw personal data dropzones
vault/dna/raw/
vault/labs/raw/
vault/store/
vault/scaffold/filled/
vault/artifacts/generated/
# Tracker-pull watched folder (operator-Shortcut Apple-Health drops + staged pulls)
vault/inbox/
# Operator-identity + operator-contact tokens for the PII scanner (per-instance; .example is tracked)
vault/meta/operator-identity.txt
vault/meta/operator-contact.txt

# operator-grounded (PII) reference docs — never commit
design/*.operator-grounded.md

# Environment
.env
.env.local
.env.*.local
.venv/

# Secret-store fallback tier (ADR-0047-T1): per-instance at-rest secret file, permission-
# gated (0600), weaker at rest than the OS keyring; never tracked — the block-pii-commit /
# pre-push-pii-scan hooks are the backstop against an ignore-bypassing git add -f
.secret-store-fallback.json

# Per-tester monthly spend-cap ledger (ADR-0049-T3/D5): per-instance at-rest cumulative
# dispatch count, permission-gated (0600); never tracked (it carries no secret, but is
# instance-local runtime state — same never-track posture as the fallback tier)
.spend-cap-ledger.json

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Runner: rendered launchd instance (operator-specific; templates are tracked, ADR-0039-T3)
scripts/runner/schedule/*.rendered.plist

# Beads sync artifacts
.beads/sync/
coordination/

# Claude runtime locks (harness-managed, local only)
.claude/scheduled_tasks.lock
.impeccable/
prototype/
vault/conversations/
