{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aplus-research/schemas/gate-3.5",
  "title": "Phase 3.5 Judge Gate Verdict",
  "type": "object",
  "required": ["phase", "verdict", "mode_threshold", "judge_verdicts", "halt_reasons", "iterations", "timestamp", "attestation_chain"],
  "additionalProperties": false,
  "properties": {
    "phase": {"const": "3.5"},
    "verdict": {"enum": ["PASS", "HALT"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "mode_threshold": {"type": "integer", "minimum": 85, "maximum": 100},
    "judge_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section", "retrieve_agent_id", "judge_agent_id", "brief_hash", "score", "verdict", "iteration"],
        "additionalProperties": false,
        "properties": {
          "section": {"type": "string"},
          "retrieve_agent_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
          "judge_agent_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
          "brief_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "verdict": {"enum": ["PASS", "HALT"]},
          "iteration": {"type": "integer", "minimum": 1, "maximum": 4},
          "dimension_scores": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10}
          },
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "iterations": {"type": "integer", "minimum": 1, "maximum": 4},
    "attestation_chain": {
      "type": "object",
      "required": ["iter_start_ts", "attest_ts", "iteration", "judge_sources"],
      "additionalProperties": false,
      "properties": {
        "iter_start_ts": {"type": "string", "format": "date-time"},
        "attest_ts": {"type": "string", "format": "date-time"},
        "iteration": {"type": "integer", "minimum": 1, "maximum": 4},
        "judge_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["section", "iteration", "sha256", "path", "mtime"],
            "additionalProperties": false,
            "properties": {
              "section": {"type": "string"},
              "iteration": {"type": "integer", "minimum": 1, "maximum": 4},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "path": {"type": "string"},
              "mtime": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "halt_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "missing-judge",
          "judge-below-threshold",
          "judge-non-convergence",
          "retrieve-judge-id-collision",
          "brief-hash-mismatch"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "properties": {
          "halt_reasons": {"maxItems": 0},
          "judge_verdicts": {"items": {"properties": {"verdict": {"const": "PASS"}}}}
        }
      }
    }
  ]
}
